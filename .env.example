# ===========================================================================
#  LANGUAGE MODEL
# ===========================================================================
#  Chat runs through Ollama locally; no hosted chat key is required.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:14b"
# Separate local model for image descriptions; does not replace OLLAMA_MODEL.
OLLAMA_VISION_MODEL="qwen2.5vl:3b"
# Optional: second Ollama server for vision (see start_ollama_dual_gpu.bat).
# Leave commented to use OLLAMA_BASE_URL for both models.
# OLLAMA_VISION_BASE_URL="http://127.0.0.1:11435"

# ===========================================================================
#  API KEYS
# ===========================================================================
#  Copy this file to `.env` (setup.bat does that for you). Keep the file
#  private; API keys can be used to access your accounts.

# Required — turns your speech into text.
# FREE. Sign up at https://console.groq.com/keys
GROQ_API_KEY=""
